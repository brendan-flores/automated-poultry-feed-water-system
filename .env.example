# Supabase Configuration
# Copy this file to .env and fill in your Supabase project credentials
# Never commit .env to version control

# Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=

# Supabase Anon Key (public key for client-side access)
# Found in your Supabase project settings under API > anon/public
SUPABASE_ANON_KEY=

# Note: The service_role key should NEVER be used in the Flutter app or firmware
# It should only be used server-side for administrative operations
